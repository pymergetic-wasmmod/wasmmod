# clangd for wasmmod (this file's directory = crate root).
#
# ALWAYS inject MicroPython TOP (-I../..) for every TU under this tree so
# host port files (modwasmmod.c → py/builtin.h) and anything that pulls
# µPy headers don't depend on PathMatch / CDB roulette. Guest-only flags
# stay in the examples/ block.
CompileFlags:
  CompilationDatabase: .
  Add:
    - -xc
    - -std=gnu11
    - -I.
    - -Isrc
    - -Ithird_party/wamr/core/iwasm/include
    - -I../..
    - -I../../ports/unix
    - -I../../ports/unix/variants/standard
    - -I../../ports/unix/build-wasm
    - -DMICROPY_PY_WASM=1
    - -DMICROPY_MODULE_BUILTIN_INIT=1
    - -DMICROPY_MODULE_BUILTIN_SUBPACKAGES=1
    - -Wno-unknown-attributes

---

# Host µPy port — not a guest TU.
If:
  PathMatch: .*/ports/micropython/.*\.(c|h)$
CompileFlags:
  Add:
    - -DPM_WASMMOD_GUEST=0

---

# Guests under examples/
If:
  PathMatch: .*/examples/.*\.(c|h|cc|cpp)$
CompileFlags:
  Add:
    - -DPM_WASMMOD_GUEST=1

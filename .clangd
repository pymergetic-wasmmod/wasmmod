# clangd for wasmmod (directory of this file = crate root).
#
# Relied-upon fact: relative -I flags are resolved against the *compile
# command's working directory*, not this file. So we point at
# compile_commands.json here (absolute -I to this crate). The os-sdk
# workspace also forces --compile-commands-dir=.vscode; keep matching
# micropython-wasmmod entries there too.
CompileFlags:
  CompilationDatabase: .

---

# Guests under examples/ — CDB already sets -I<crate> -DPM_WASMMOD_GUEST.
If:
  PathMatch: .*/examples/.*\.(c|h|cc|cpp)$
CompileFlags:
  Add:
    - -DPM_WASMMOD_GUEST=1
    - -Wno-unknown-attributes

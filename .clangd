# clangd for extmod/wasmmod. Workspace clangd uses --compile-commands-dir=.vscode;
# relative -I are from this file (µPy TOP is ../..). Host C cards use unix
# build-wasm genhdr; µPy faces (modwasmmod/modcdn/…) use unix build-metal
# (MICROPY_PY_WASM=1 METAL=1 — has MP_QSTR_net / CDN names).
#
# PathMatch is vs the path clangd has (crate-relative or absolute). Anchor
# on the filename so both forms match.
#
# ports/micropython TUs need py/obj.h so MP_REGISTER_ROOT_POINTER is a
# macro (empty), not an implicit-int function.
CompileFlags:
  CompilationDatabase: .
  Remove:
    - -I*/ports/unix/build-standard
    - -I*/build-standard
  Add:
    - -xc
    - -std=gnu11
    - -I.
    - -Isrc
    - -Ithird_party/wamr/core/iwasm/include
    - -I../..
    - -I../../ports/unix
    - -I../../ports/unix/variants/standard
    - -DMICROPY_PY_WASM=1
    - -DMICROPY_MODULE_BUILTIN_INIT=1
    - -DMICROPY_MODULE_BUILTIN_SUBPACKAGES=1
    - -Wno-unknown-attributes

---
If:
  PathMatch: .*/ports/micropython/.*\.[ch]$
CompileFlags:
  Remove:
    - "-I*build-wasm"
  Add:
    - -I../../ports/unix/build-metal
    - -include
    - ports/micropython/mpconfig_wasm.h
    - -DPM_WASMMOD_GUEST=0

---
If:
  PathMatch: .*\.[ch]$
  PathExclude: .*/ports/micropython/.*\.[ch]$
CompileFlags:
  Add:
    - -I../../ports/unix/build-wasm

---
If:
  PathMatch: .*/ports/cpython/.*\.[ch]$
CompileFlags:
  Add:
    - -Iports/cpython/stubs
    - -I../..
    - -I../../lib/uzlib
    - -I/usr/include/python3.12
    - -DPM_WASMMOD_CPYTHON=1
    - -DPM_WASMMOD_GUEST=0
    - -DMICROPY_PY_DEFLATE=1

Diagnostics:
  UnusedIncludes: None

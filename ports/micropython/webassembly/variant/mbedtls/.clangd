# Header-only mbedtls port config. clangd fallback cwd is this directory, so
# -I../.. from wasmmod/.clangd does not reach metalpython TOP.
# Paths below are relative to this directory (same as fallback cwd).
CompileFlags:
  CompilationDatabase: None
  Add:
    - -xc
    - -std=gnu99
    # TOP (metalpython) — seven levels up from variant/mbedtls
    - -I../../../../../../..
    # ports/webassembly (mpconfigport.h)
    - -I../../../../../../../ports/webassembly
    # VARIANT_DIR
    - -I..
    # build genhdr
    - -I../../../../../../../ports/webassembly/build-wasmmod
Diagnostics:
  # Config headers only pull macros; IncludeCleaner has nothing to attach usage to.
  UnusedIncludes: None
